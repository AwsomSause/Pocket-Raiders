  "lines": {
    "loyal": { "hello": ["Ready when you are, Boss.", "Whatever you need, Boss."], "done": ["Done, Boss. Like you asked.", "Job's done. For the crew."], "fail": ["I let you down, Boss. Won't happen twice.", "Didn't go right. I'll fix it."], "scared": ["I didn't talk, Boss. Not a word.", "They can lock me up. I'm still yours."], "pay": ["Pay's not why I'm here, Boss.", "Thanks, Boss. Same time next week."] },
    "greedy": { "hello": ["What's the job pay, Boss?", "Got anything with a bonus in it?"], "done": ["Job's done, Boss. Pay's fair.", "Done. Now, about my cut."], "fail": ["No money in that one, Boss.", "Waste of a night. Unpaid, too."], "scared": ["Bail money better be coming, Boss.", "Cops took my wallet. My wallet!"], "pay": ["Pay day. Best day.", "Counted it twice. It's all there."] },
    "joker": { "hello": ["Why did the Grimer cross the road? To get to the other slime.", "Boss! You look great. Terrible, but great."], "done": ["Done! Nobody even noticed. Mostly.", "Job's done. Tell the others how cool I was."], "fail": ["So that went great. In the bad way.", "Funny story. Not funny. Still a story."], "scared": ["The cop laughed at my joke. Still booked me.", "Jail's fine. Bad crowd, though."], "pay": ["Money! I'll spend it all on Lava Cookies.", "Pay day. Party at mine."] },
    "hothead": { "hello": ["Point me at someone, Boss.", "Who's first?"], "done": ["Done. They won't forget me.", "Hit 'em hard, like you said."], "fail": ["They got lucky! Next time, they're mine.", "I'm not done with them."], "scared": ["Let me out and I'll show 'em!", "I'd have won if they fought fair."], "pay": ["Fine. Now let me hit something.", "Pay's okay. Fighting's better."] },
    "coward": { "hello": ["Is it safe, Boss? Is it?", "Do I have to go out tonight?"], "done": ["I did it! I didn't even scream.", "Done, Boss. Can I sit down?"], "fail": ["I ran. I'm sorry. I ran.", "There was a noise, Boss. A big one."], "scared": ["Please don't let them keep me, Boss.", "I told them nothing! Mostly nothing."], "pay": ["Thank you, Boss. I'll hide it well.", "Pay's good. Safe is better."] },
    "zealot": { "hello": ["For the cause, Boss.", "The team comes first. Always."], "done": ["Done. The cause grows.", "It was an honour, Boss."], "fail": ["The cause will forgive me. Will you?", "I'll pay for that failure."], "scared": ["They can't jail an idea, Boss.", "I'd do it again. For the team."], "pay": ["Keep it, Boss. Spend it on the team.", "I don't need much. The team does."] },
    "proud": { "hello": ["You called for the best, Boss?", "I hope it's a job worth my time."], "done": ["Flawless. As usual.", "Done. Make sure the others hear."], "fail": ["That was not my fault.", "Bad luck. My skills were perfect."], "scared": ["Do you know who I am, officer?", "This is beneath me."], "pay": ["About time.", "Fair. Barely."] },
    "cautious": { "hello": ["Checked the route twice, Boss.", "Let's plan it first."], "done": ["Done. No one saw. I checked.", "Quiet job, clean job."], "fail": ["Too risky. I backed off.", "Better a miss than a cell, Boss."], "scared": ["I followed the plan. The plan was wrong.", "I knew this would happen."], "pay": ["I'll save most of it.", "Into the jar it goes."] },
    "gossip": { "hello": ["Did you hear about the Gym Leader?", "Boss! You'll never guess who I saw."], "done": ["Done. And guess what I heard on the way.", "Job's done. Oh, and big news."], "fail": ["Missed it. But I heard something good.", "Didn't work. Don't tell the others."], "scared": ["The cops gossip too, you know.", "I heard the cells are nicer upstairs."], "pay": ["Pay day! Who got a raise? Tell me.", "Thanks. Did the new one get more?"] },
    "loner": { "hello": ["Just give me the job.", "Alone is fine."], "done": ["Done.", "Did it my way."], "fail": ["Didn't work. Leave it.", "My problem. I'll sort it."], "scared": ["Don't send anyone. I'll get out.", "Fine. Quiet in here."], "pay": ["Mm.", "Fine."] },
    "kind": { "hello": ["Everyone eaten today, Boss?", "Your team looks tired. Rest them?"], "done": ["Done. Nobody got hurt.", "Job's done. I brought snacks back."], "fail": ["I couldn't. They had kids, Boss.", "Didn't go well. Is everyone okay?"], "scared": ["Feed my Pokémon while I'm in, please.", "I'm okay. Look after the others."], "pay": ["Thank you, Boss. Really.", "I'll get the crew dinner."] },
    "schemer": { "hello": ["I have a little idea, Boss.", "What if we did it differently?"], "done": ["Done. Exactly as I planned.", "All according to plan."], "fail": ["A setback. Part of the plan.", "Interesting. I'll learn from that."], "scared": ["Cells have doors. Doors have keys.", "I planned for this. Mostly."], "pay": ["Pay is just the start.", "Noted. I'm counting, Boss."] }
