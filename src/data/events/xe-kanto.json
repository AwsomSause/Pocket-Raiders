   "intro": "A black car idles at the curb. A woman with a tablet steps out. \"You're difficult to schedule. I have eleven minutes, so I'll be direct. The Boss has noticed you. Being noticed is expensive. He would like to make it cheap.\"",
   "choices": [
    {
     "label": "Take the envelope",
     "success": {
      "text": "₽5,000 and a month of quiet. \"I'll put you down as 'bought'.\"",
      "effects": [
       {
        "kind": "money",
        "amount": 5000
       },
       {
        "kind": "evil",
        "heat": -20
       },
       {
        "kind": "flag",
        "key": "rocket-bought",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Refuse",
     "success": {
      "text": "\"I'll put you down as 'declined'. He keeps that list short.\"",
      "effects": [
       {
        "kind": "evil",
        "heat": 5
       },
       {
        "kind": "flag",
        "key": "rocket-declined",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Take it, and take it to Officer Jenny",
     "success": {
      "text": "The police hold the evidence. The envelope stays with them.",
      "effects": [
       {
        "kind": "flag",
        "key": "rocket-wire",
        "amount": 1
       },
       {
        "kind": "attribute",
        "key": "goodEvil",
        "amount": 3
       }
      ]
     }
    },
    {
     "label": "\"Does he always send you?\"",
     "success": {
      "text": "A pause, the first. \"He sends me when he'd rather not send Domino. Take that as a compliment.\"",
      "effects": [
       {
        "kind": "flag",
        "key": "rocket-matori-line",
        "amount": 1
       }
      ]
     }
    }
   ]
  },
