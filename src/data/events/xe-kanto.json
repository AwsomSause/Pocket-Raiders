   "intro": "A desk phone rings as you leave the hideout. \"Don't hang up, dear. I built this from a card table and one stolen Pidgey. He's made it into a company. I'm proud. It's also boring. You're the first interesting thing in his books in years.\"",
   "choices": [
    {
     "label": "\"Who is this?\"",
     "success": {
      "text": "\"The founder. Sit up straight. He'll be on the roof. He always saves something for the roof.\"",
      "effects": [
       {
        "kind": "flag",
        "key": "rocket-madame",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "\"Why help me?\"",
     "success": {
      "text": "\"I'm not. I'm watching. But he'll be on the roof.\"",
      "effects": [
       {
        "kind": "flag",
        "key": "rocket-madame",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Hang up",
     "success": {
      "text": "The phone rings again at the next rest stop. She is laughing.",
      "effects": []
