 "events": [
  {
   "id": "gn-new-24",
   "name": "The Night Shift at the Day-Care",
   "group": "Greenneedle",
   "stop": "event",
   "rarity": "rare",
   "forced": true,
   "requires": [
    {
     "kind": "flag",
     "key": "night-shift-done",
     "atLeast": 0,
     "atMost": 0
    }
   ],
   "scene": {
    "cast": [
     "trainer.oldman"
    ],
    "tint": "#1f2a44",
    "effect": "none"
   },
   "intro": "It is midnight. The day-care couple stand in their garden holding a frying pan and a broom, and they are not joking.\n\n**Mr. Holloway:** \"Three day-cares this week. Eggs gone. We've forty in the shed.\"\n\n**Mrs. Holloway:** \"We're not as quick as we were. Would you?\"",
   "choices": [
    {
     "label": "Take the night shift.",
     "success": {
      "text": "Mrs. Holloway presses the broom into your hand. It is warm from hers. Mr. Holloway locks the shed, and checks it twice.",
      "effects": [
       {
        "kind": "gn",
        "op": "scene",
        "key": "gn-new-24-sent-1"
       }
      ]
     }
    },
    {
     "label": "Not tonight.",
     "success": {
      "text": "Mr. Holloway nods like he expected it. The shed light stays on behind you for a long time.",
      "effects": []
     }
    }
   ]
  },
