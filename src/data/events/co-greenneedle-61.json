     "id": "taken",
     "when": [
      {
       "kind": "anyFlag",
       "keys": [
        "hoenn-took-all",
        "called-it-for-us"
       ]
      }
     ],
     "notice": "*The field is full. Nobody is talking. They came because they were told to. Only your rival walks up.*"
    }
   ],
   "room": true,
   "scene": {
    "cast": [],
    "tint": "#5a4a6b",
    "effect": "none"
   },
   "intro": "{reunion:crowd}\n\n*No one is asking for a speech. There are rugs on the grass and lanterns in the trees, and the evening is going slowly.*\n\n*Nobody has to fight tonight. Nobody has to win. They all got here by walking.*",
   "choices": [
    {
     "label": "Walk among them and talk.",
     "success": {
      "text": "You go in. People make room without being asked, and then close up behind you.",
      "effects": [
       {
        "kind": "addEvent",
        "eventId": "gn-61-walk"
       }
      ]
     }
    },
    {
     "label": "Introduce two people who should meet.",
     "success": {
      "text": "You look around the field for two who have never been in a room together.",
      "effects": [
       {
        "kind": "addEvent",
        "eventId": "gn-61-intro"
       }
      ]
     },
     "showIf": [
      {
       "kind": "anyFlag",
       "keys": [
