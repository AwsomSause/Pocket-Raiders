        "op": "scene",
        "key": "gn-44-round-1"
       }
      ]
     }
    },
    {
     "label": "Not today.",
     "success": {
      "text": "**Ms. Brady:** \"The form will keep.\"",
      "effects": []
     }
    }
   ]
  },
