        "op": "stampRegion",
        "key": "onevone-at"
       },
       {
        "kind": "gn",
        "op": "scene",
        "key": "gn-44-desk"
       }
      ]
     }
    },
    {
     "label": "Walk on.",
     "success": {
      "text": "Through the window, someone in a knitted hat is losing in round four, cheerfully.",
      "effects": []
     }
    }
   ]
