  {
   "id": "co-rule-landmark",
   "name": "A Regional Landmark",
   "group": "Signs and Tellings",
   "rarity": "uncommon",
   "requires": [
    {
     "kind": "flag",
     "key": "blessed",
     "atLeast": 1,
     "atMost": 99
    }
   ],
   "scene": {
    "cast": [
     "trainer.ruin_maniac"
    ],
    "tint": "#a08060",
    "effect": "none"
   },
   "intro": "One of the region's great landmarks: the kind of place on every postcard. A guide in a faded cap is packing up for the day.\n\nGuide: \"Everyone takes the photo. Nobody asks what it was built for.\"",
   "choices": [
    {
     "label": "\"What was it built for?\"",
     "success": {
      "text": "The guide tells you a secret the postcards leave out: it was built for a Legendary, a long time ago. You feel something far off turn toward you.",
      "effects": [
       {
        "kind": "flag",
        "key": "sign-own",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Walk all the way round it.",
     "success": {
      "text": "On the far side, where nobody goes, a carving of a great shape. Your Pokémon go quiet looking at it.",
      "effects": [
       {
        "kind": "flag",
        "key": "sign-own",
        "amount": 1
       },
       {
        "kind": "friendship",
        "amount": 1,
        "who": "party"
       }
      ]
     }
    },
    {
     "label": "Take the photo and go.",
     "success": {
      "text": "It is a very good photo.",
      "effects": []
     }
    }
   ]
  },
  {
   "id": "co-rule-shrine",
   "name": "An Old Shrine",
   "group": "Signs and Tellings",
   "rarity": "uncommon",
   "requires": [
    {
     "kind": "flag",
     "key": "blessed",
     "atLeast": 1,
     "atMost": 99
    }
   ],
   "scene": {
    "cast": [],
    "tint": "#c0a060",
    "effect": "none"
   },
   "intro": "A small shrine by the road, older than the road. Offerings are left here for whichever Legendary is listening.",
   "choices": [
    {
     "label": "Leave an offering (₽200).",
     "requires": [
      {
       "kind": "money",
       "atLeast": 200
      }
     ],
     "success": {
      "text": "The coins settle. The wind changes direction, just for a moment.",
      "effects": [
       {
        "kind": "money",
        "amount": -200
       },
       {
        "kind": "flag",
        "key": "sign-own",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Ring the bell.",
     "success": {
      "text": "One clear note. Something answers, a long way off.",
      "effects": [
       {
        "kind": "flag",
        "key": "sign-own",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Bow and walk on.",
     "success": {
      "text": "The shrine keeps its own counsel.",
      "effects": []
     }
    }
   ]
  },
  {
   "id": "co-rule-ruin",
   "name": "Ruin Inscriptions",
   "group": "Signs and Tellings",
   "rarity": "uncommon",
   "requires": [
    {
     "kind": "flag",
     "key": "promises-on",
     "atLeast": 1,
     "atMost": 99
    }
   ],
   "scene": {
    "cast": [
     "trainer.ruin_maniac"
    ],
    "tint": "#807060",
    "effect": "none"
   },
   "intro": "A broken wall covered in old writing. Half of it is about a great Legendary; the other half is about something small that walks where it likes.",
   "choices": [
    {
     "label": "Read the Legendary half.",
     "requires": [
      {
       "kind": "flag",
       "key": "blessed",
       "atLeast": 1,
       "atMost": 99
      }
     ],
     "success": {
      "text": "A Legend, named in a language nobody speaks now. You can almost hear it.",
      "effects": [
       {
        "kind": "flag",
        "key": "sign-own",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Read the other half.",
     "success": {
      "text": "A small story, carefully carved, about something nobody quite believes in.",
      "effects": [
       {
        "kind": "flag",
        "key": "telling-any",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Leave it.",
     "success": {
      "text": "The wall has waited this long.",
      "effects": []
     }
    }
   ]
  },
  {
   "id": "co-rule-tale",
   "name": "A Campfire Tale",
   "group": "Signs and Tellings",
   "rarity": "uncommon",
   "requires": [
    {
     "kind": "flag",
     "key": "promises-on",
     "atLeast": 1,
     "atMost": 99
