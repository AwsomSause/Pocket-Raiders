   ],
   "scene": {
    "cast": [
     "trainer.hiker"
    ],
    "tint": "#c06030",
    "effect": "none"
   },
   "intro": "Another traveller shares your fire. When the food is gone, she leans back.\n\nTraveller: \"Want to hear something nobody believes?\"",
   "choices": [
    {
     "label": "\"Tell me.\"",
     "success": {
      "text": "She tells it well. You find yourself believing a little of it.",
      "effects": [
       {
        "kind": "flag",
        "key": "telling-any",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Trade a story of your own.",
     "success": {
      "text": "You tell her about your run. She tells you something better.",
      "effects": [
       {
        "kind": "flag",
        "key": "telling-any",
        "amount": 1
       },
       {
        "kind": "friendship",
        "amount": 1,
        "who": "party"
       }
      ]
     }
    },
    {
     "label": "Sleep.",
     "success": {
      "text": "You sleep well by the fire.",
      "effects": [
       {
        "kind": "heal",
        "share": 0.2
       }
      ]
     }
    }
   ]
  },
  {
