        "key": "lc-won",
        "n": 1
       }
      ]
     }
    }
   ]
  },
  {
   "id": "gn-new-27-letter",
   "name": "A Letter from Tansy-Jane",
   "group": "Greenneedle",
   "tags": [
    "Story"
   ],
   "stop": "event",
   "rarity": "common",
   "callback": true,
   "requires": [
    {
     "kind": "flag",
     "key": "lc-result",
     "atLeast": 1,
     "atMost": 99
    },
    {
     "kind": "flag",
     "key": "lc-letter",
     "atLeast": 0,
     "atMost": 0
    }
   ],
   "remembers": [
    {
     "id": "won",
     "when": [
      {
       "kind": "flag",
       "key": "lc-won",
       "atLeast": 1,
       "atMost": 99
      }
     ],
     "notice": "The letter begins with one word, underlined three times: *HOW.*"
    }
   ],
   "scene": {
    "cast": [],
    "tint": "#6b8f4a",
    "effect": "none"
   },
   "intro": "*A letter, in a hand that slopes uphill. Tansy-Jane.*\n\nShe asks how you beat it. Then, because she is kind, she tells you how you could have: \"Keep the sun out. Or just be faster. Mostly be faster.\"\n\n\"Next year,\" it ends. \"Same time. Bring something small.\"",
   "choices": [
    {
     "label": "Read it twice.",
     "success": {
      "text": "You read it again on the road. It reads better the second time. Some letters do.",
      "effects": [
       {
        "kind": "flag",
        "key": "intel",
        "amount": 1
       },
       {
        "kind": "gn",
        "op": "setFlag",
        "key": "lc-letter",
        "n": 1
       }
      ]
     }
    },
    {
     "label": "Write back.",
     "success": {
      "text": "You write four lines, and one of them is a joke. You hope she gets it.",
      "effects": [
       {
        "kind": "friendship",
        "amount": 5,
        "who": "lead"
