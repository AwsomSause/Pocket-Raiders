    "tint": "#5a6670",
    "effect": "none"
   },
   "intro": "Five errands, and the shop is quiet. The Rotom hangs between the appliances, one light on, and looks at you.\n\n**Dufresne:** \"Now. Say it, if you know it. Or don't. It's a fine thing either way.\"",
   "choices": [
    {
     "label": "\"You liked that one.\"",
     "success": {
      "text": "You think back over the day. Which one did it hum through?",
      "effects": [
       {
        "kind": "gn",
        "op": "scene",
        "key": "gn-new-23-name-1"
       }
      ]
     }
    },
    {
     "label": "\"You don't have to pick.\"",
     "success": {
      "text": "It lets the shop be. It steps out of the tangle of wires, plain, one little light, with Mr. Dufresne's old radio carried under one arm. The radio crackles. Somewhere it is playing a song. It knows the words.",
      "effects": [
       {
        "kind": "join",
        "shadow": false,
        "species": [
         "rotom"
        ],
        "types": [],
        "levelBonus": 0,
        "shinyMultiplier": 1
       },
       {
        "kind": "teachMove",
        "move": "house-call",
        "species": "rotom"
       },
       {
        "kind": "gn",
        "op": "setFlag",
        "key": "appliance-done",
        "n": 1
       },
       {
        "kind": "moment",
        "text": "A Rotom left an appliance shop plain, carrying a radio.",
        "importance": 60
       }
      ]
     }
    }
   ]
  },
