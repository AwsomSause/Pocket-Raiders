     "kind": "rivalMet",
     "atLeast": 1
    }
   ],
   "intro": "The rival has five Pokémon out at camp. The sixth Ball sits on the log beside them, and it is cracked. \"Don't ask,\" they say. A long silence. \"...It was a wild battle. A stupid one. I pushed. I keep the Ball. I don't know why.\"",
   "choices": [
    {
     "label": "Sit with them.",
     "success": {
      "text": "Nobody talks. The fire does the work.",
      "effects": [
       {
        "kind": "rivalChange",
        "feelings": {
         "trust": 2
        },
        "lead": 0
       },
       {
        "kind": "flag",
        "key": "rival-grief-shared",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Tell them about one I lost.",
     "requires": [
      {
       "kind": "oldFoe"
      }
     ],
     "success": {
      "text": "You tell them about the one a wild foe took from you. They listen, then ask its name.",
      "effects": [
       {
        "kind": "rivalChange",
        "feelings": {
         "trust": 3
        },
        "lead": 0
       },
       {
        "kind": "flag",
        "key": "rival-knows-lost",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Battle. It'll help.",
     "success": {
      "text": "They stand up too fast. \"Fine.\" They are distracted, and it shows.",
      "effects": [
       {
        "kind": "rivalChange",
        "feelings": {
         "trust": -1
        },
        "lead": 0
       }
      ],
      "battle": {
       "kind": "trainer",
       "rival": true,
       "name": "Your rival",
       "size": 5,
       "levelBonus": 0,
       "win": []
      }
     }
    }
   ],
   "remembers": [
    {
     "id": "winning",
     "when": [
      {
       "kind": "rivalState",
       "leadAtLeast": 2
      }
     ],
     "notice": "\"I was winning,\" they say, to nobody. \"That's the stupid part.\""
    }
   ]
