   ],
   "intro": "A shop has a HELP WANTED sign. You and the rival reach for it at the same time. The shopkeeper, Mr. Abernathy-Finch, folds his arms. \"One position. A day's work. ₽600. Convince me.\" \"I'm faster,\" says the rival.",
   "choices": [
    {
     "label": "Out-argue them.",
     "check": "charisma",
     "success": {
      "text": "Three questions, three good answers. The job is yours.",
      "effects": [
       {
        "kind": "money",
        "amount": 600
       },
       {
        "kind": "rivalChange",
        "feelings": {},
        "lead": -1
       }
      ]
     },
     "failure": {
      "text": "You lose the argument. They get the job and a smug look.",
      "effects": [
       {
        "kind": "rivalChange",
        "feelings": {},
        "lead": 1
       }
      ]
     }
    },
    {
     "label": "Let them have it.",
     "success": {
      "text": "They are suspicious, then grateful.",
      "effects": [
       {
        "kind": "rivalChange",
        "feelings": {
         "trust": 1
        },
        "lead": 0
       }
      ]
     }
    },
    {
     "label": "Split it.",
     "success": {
      "text": "Both of you work. Both are bad at it. ₽300 each, and a complaint about 'the two shouting ones'.",
      "effects": [
       {
        "kind": "money",
        "amount": 300
       },
       {
        "kind": "rivalChange",
        "feelings": {
         "trust": 2
        },
        "lead": 0
       },
       {
        "kind": "flag",
        "key": "rival-split-job",
        "amount": 1
       }
      ]
     }
    }
   ],
   "remembers": []
  },
