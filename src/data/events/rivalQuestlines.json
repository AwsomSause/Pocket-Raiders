   "choices": [
    {
     "label": "Send it.",
     "success": {
      "text": "They post it at the next town.",
      "effects": [
       {
        "kind": "flag",
        "key": "rival-letter-sent",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Burn it.",
     "success": {
      "text": "They watch it go, and say nothing.",
      "effects": [
       {
        "kind": "flag",
        "key": "rival-letter-burnt",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Read it to me first.",
     "success": {
      "text": "They do. It is short. It ends: \"I met someone who makes me want to be good at this for me.\" They post it at the next town.",
      "effects": [
       {
        "kind": "rivalChange",
        "feelings": {
         "trust": 3
        },
        "lead": 0
       },
       {
        "kind": "flag",
        "key": "rival-read-letter",
        "amount": 1
       },
       {
        "kind": "flag",
        "key": "rival-letter-sent",
        "amount": 1
       }
      ]
     }
    }
   ],
