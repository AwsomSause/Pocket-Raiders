  {
   "id": "boss-rematch-disguise",
   "name": "A Familiar Stranger",
   "group": "Emergent Stories",
   "rarity": "rare",
   "minStage": 4,
   "scene": {
    "cast": [
     "boss.hop"
    ],
    "tint": "#1e1e2c",
    "effect": "fog"
   },
   "intro": "Rain, the soft kind that soaks you without noticing. A trainer in a rain poncho, hood up, steps out to meet you. They walk like someone who has done this many times before. They have your stride, exactly. The Poncho: \"Quick battle? I've a long way to go.\" The Pokémon at their side is a {lead}. Not like yours. Yours.",
   "choices": [
    {
     "label": "Battle.",
     "success": {
      "text": "The Poncho nods, as if they knew you would. Every Pokémon they send out is one of yours, a little older, a little more tired, moving the way yours will someday.",
      "effects": [],
      "battle": {
       "kind": "trainer",
       "friendly": true,
       "lose": [
        {
         "kind": "addEvent",
         "eventId": "stranger-after"
        }
       ],
       "name": "The Poncho",
       "classId": "ace-trainer",
       "mirror": true,
       "size": 6,
       "types": [],
       "levelBonus": 0,
       "win": [
        {
         "kind": "addEvent",
         "eventId": "stranger-after"
        }
       ]
      }
     }
    },
    {
     "label": "Take your hood down.",
     "success": {
      "text": "They hesitate, then push the hood back. The face under it is yours. A little tired. A little older around the eyes. The Poncho: \"It doesn't get easier. It gets better.\"",
      "effects": [
       {
        "kind": "addEvent",
        "eventId": "stranger-talk"
       }
      ]
     }
    },
    {
     "label": "I know that Pokémon.",
     "success": {
      "text": "The Poncho looks at their {lead}, and then at yours. The Poncho: \"So do I.\" A long breath, rain running off the hood. The Poncho: \"It doesn't get easier. It gets better.\"",
      "effects": [
       {
        "kind": "addEvent",
        "eventId": "stranger-talk"
       }
      ]
     }
    }
   ]
  },
