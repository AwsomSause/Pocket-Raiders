    ],
    "tint": "#1e1e2c",
    "effect": "fog"
   },
   "intro": "The Poncho calls their {lead} back. Before it goes, it and your {lead} stand nose to nose in the rain for a long moment, and neither of them blinks. The Poncho: \"It doesn't get easier. It gets better.\"",
   "choices": [
    {
     "label": "Who are you?",
     "success": {
      "text": "The Poncho smiles under the hood. \"You know.\" They walk away into the rain.",
      "effects": []
     }
    },
    {
     "label": "Again.",
     "success": {
      "text": "\"Again,\" the Poncho agrees, and this time they don't hold anything back. This is your team at its very best.",
      "effects": [],
      "battle": {
       "kind": "trainer",
       "friendly": true,
       "lose": [
        {
         "kind": "addEvent",
         "eventId": "stranger-after-2"
