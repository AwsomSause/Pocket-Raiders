  {
   "id": "dark-deal",
   "name": "Dark Deal",
   "group": "PokeRogue-style encounters",
   "rarity": "rare",
   "minStage": 3,
   "scene": {
    "cast": [
     "trainer.psychic_m"
    ],
    "tint": "#180820",
    "effect": "flicker"
   },
   "intro": "A dim lab behind a door that should have been locked. A scientist in a stained coat holds a humming device against his chest like a baby. Dr. Vreel: \"Give me one Pokémon. I'll give you a legend. Maybe.\" Dr. Vreel: \"The device closes a heart and opens a door. What comes through is very strong, and very unhappy.\" A screen behind him reads: SHADOW CONVERSION: 4 OF 4 SUCCESSFUL.",
   "choices": [
    {
     "label": "What happens to the one I give you?",
     "success": {
      "text": "Vreel doesn't even look up. \"It goes to my employers. You'll see it again, probably.\" He finally meets your eyes. \"On the other side.\"",
      "effects": [
       {
        "kind": "addEvent",
        "eventId": "dark-deal"
       }
      ]
     }
    },
    {
     "label": "Deal.",
     "requires": [
      {
       "kind": "partySize",
       "atLeast": 2
      }
     ],
     "pick": {},
     "success": {
      "text": "You point. Vreel takes the Ball without a word and puts it in the machine, and the hum climbs, and the lights flicker, and the door at the back of the lab opens. What walks out is a legend, and its eyes are dark, and it does not look at you. It must be purified before it will truly fight for you. Using it is up to you.",
      "effects": [
       {
        "kind": "notePicked",
        "key": "dark-deal",
        "take": true
       },
       {
        "kind": "regionJoin",
        "table": "darkDeal",
        "shadow": true
       },
       {
        "kind": "flag",
        "key": "dark-dealt",
        "amount": 1,
        "stamp": "region"
       },
       {
        "kind": "attribute",
        "key": "goodEvil",
        "amount": -3
       },
       {
        "kind": "flag",
        "key": "cruelty-act",
        "amount": 1
       }
      ]
     }
    },
    {
     "label": "Report you.",
     "success": {
      "text": "You run for the nearest phone. When the officers break the door down, the lab is empty, the device gone, Vreel gone. But his notes are still on the desk, and one page lays out the next step of his employers' plan.",
      "effects": [
       {
        "kind": "flag",
        "key": "dark-reported",
        "amount": 1
       },
       {
        "kind": "flag",
        "key": "reported-crime",
        "amount": 1
       },
       {
        "kind": "flag",
