   "intro": "An old traveler squints at the sky, then at you. \"Fronts, storms, sun that bites. I know what the road will hold. Fifty coins and I will tell you.\"",
   "choices": [
    {
     "label": "Pay for the forecast (₽50)",
     "requires": [
      {
       "kind": "money",
       "atLeast": 50
      }
     ],
     "success": {
      "text": "He taps the dirt and draws the weather in lines. You can see further ahead now.",
      "effects": [
       {
        "kind": "money",
        "amount": -50
       },
       {
        "kind": "foresight",
        "columns": 6
       }
      ]
     }
    },
    {
     "label": "Chat for free",
     "success": {
      "text": "\"Wind from the west,\" he says. A small hint, nothing more.",
      "effects": [
       {
        "kind": "foresight",
        "columns": 1
       }
      ]
     }
    },
    {
     "label": "Walk on",
     "success": {
      "text": "He shrugs and goes back to watching the clouds.",
      "effects": []
     }
    }
   ]
  },
