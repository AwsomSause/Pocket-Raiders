  {
   "id": "guide-betrayal",
   "name": "The Guide Returns",
   "group": "Story and characters",
   "stop": "event",
   "rarity": "uncommon",
   "minStage": 3,
   "scene": {
    "cast": [
     "trainer.worker_m"
    ],
    "tint": "#2a2230",
    "effect": "none"
   },
   "intro": "Your old guide waits at the crossing, a little too relaxed. Two strangers lean on the fence behind him. \"Hand over your coins,\" he says, not meeting your eyes.",
   "choices": [
    {
     "label": "Pay up (₽100)",
     "requires": [
      {
       "kind": "money",
       "atLeast": 100
      }
     ],
     "success": {
      "text": "You pay. He mumbles an apology. You will not forget his face.",
      "effects": [
       {
        "kind": "money",
        "amount": -100
       },
       {
        "kind": "flag",
        "key": "guide-betrayed"
       }
      ]
     }
    },
    {
     "label": "Call out his name, calmly",
     "requires": [
      {
       "kind": "attribute",
       "key": "charisma",
       "atLeast": 4
      }
     ],
     "success": {
      "text": "He flinches. The strangers slip away. \"I owed them,\" he whispers. \"Thank you.\"",
      "effects": [
       {
        "kind": "flag",
        "key": "betrayal-forgiven"
       },
       {
        "kind": "moment",
        "text": "Forgave a guide who betrayed you.",
        "importance": 70
       }
      ]
     }
    },
    {
     "label": "Stand your ground",
     "success": {
      "text": "Your team steps forward. The strangers vanish, and so does he.",
      "effects": [
       {
        "kind": "flag",
        "key": "guide-betrayed"
       }
      ]
     }
    }
   ],
   "requires": [
    {
     "kind": "flag",
     "key": "guide-trust",
     "atLeast": 1,
     "atMost": 99
    },
    {
     "kind": "flag",
     "key": "guide-betrayed",
     "atLeast": 0,
     "atMost": 0
    },
    {
     "kind": "flag",
     "key": "betrayal-forgiven",
     "atLeast": 0,
     "atMost": 0
    }
   ]
